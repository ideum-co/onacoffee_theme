{%- comment -%}
  Product card matching the collection page layout.
  Usage: {% render 'ona-product-card', product: product %}
  v2: includes variant picker and add-to-cart button
{%- endcomment -%}
{%- if product.handle != 'ona-tote' -%}
{%- assign v0 = product.selected_or_first_available_variant -%}
{%- assign card_uid = section.id | append: '-' | append: product.id | append: '-' | append: index -%}
{%- assign card_form_id = 'ona-card-form-' | append: card_uid -%}
<div class="list wowo fadeInUp" data-ona-card data-product-id="{{ product.id }}"
  data-add-label="{{ 'products.product.add_to_cart' | t | escape }}"
  data-adding-label="Adding…"
  data-sold-out-label="{{ 'products.product.sold_out' | t | escape }}"
  data-error-label="Error">
  <a href="{{ product.url }}" class="list-box" data-product-link data-product-url="{{ product.url }}">
    <div class="img">
      {%- assign _feat = product.featured_image -%}
      <img
        src="{{ _feat | image_url: width: 600 }}"
        srcset="{{ _feat | image_url: width: 400 }} 400w,
                {{ _feat | image_url: width: 600 }} 600w,
                {{ _feat | image_url: width: 900 }} 900w"
        sizes="(max-width: 575px) calc(50vw - 16px),
               (max-width: 990px) calc(33vw - 16px),
               280px"
        width="{{ _feat.width | default: 1024 }}"
        height="{{ _feat.height | default: 1024 }}"
        {% if index == 1 %}
          loading="eager"
          fetchpriority="high"
        {% elsif index != blank and index <= 4 %}
          loading="eager"
          decoding="async"
        {% else %}
          loading="lazy"
          decoding="async"
        {% endif %}
        alt="{{ _feat.alt | default: product.title | escape }}">
    </div>

    <div class="text">
      {% render 'ona-product-tags', product: product %}

      {%- liquid
        assign price = product.price | money
        assign compare_at_price = product.compare_at_price
        assign on_sale = false
        if compare_at_price > product.price
          assign on_sale = true
        endif
      -%}
      <div class="price{% if on_sale %} price--on-sale{% endif %}" data-card-price-wrap>
        {%- if product.price_varies -%}
          <span class="price-item" data-card-price>{{ 'products.product.from_lowest_price_html' | t: lowest_price: price }}</span>
        {%- else -%}
          <span class="price-item" data-card-price>{{ v0.price | money }}</span>
        {%- endif -%}
        {%- if on_sale -%}
          <span class="price-item price-item--compare"><s>{{ compare_at_price | money }}</s></span>
        {%- endif -%}
      </div>
      <p>{{ product.title }}</p>
    </div>
  </a>

  <div class="add-to-cart ona-pc__actions">
    {%- if product.variants.size > 1 and product.options.size == 1 -%}
      {%- assign opt_name = product.options.first -%}
      <div class="ona-pc__opt">
        <span class="ona-pc__opt-label">{{ opt_name }}: <strong data-card-opt-value>{{ v0.title }}</strong></span>
        <div class="ona-pc__opt-pills">
          {%- for var in product.variants -%}
            {%- liquid
              assign var_on_sale = false
              if var.compare_at_price > var.price
                assign var_on_sale = true
              endif
              assign radio_id = card_uid | append: '-' | append: var.id
            -%}
            <input
              type="radio"
              id="{{ radio_id }}"
              name="id"
              value="{{ var.id }}"
              form="{{ card_form_id }}"
              data-card-variant
              data-variant-id="{{ var.id }}"
              data-variant-title="{{ var.title | escape }}"
              data-variant-price="{{ var.price | money | strip_html | escape }}"
              data-variant-on-sale="{{ var_on_sale }}"
              data-variant-compare-price="{% if var_on_sale %}{{ var.compare_at_price | money | strip_html | escape }}{% endif %}"
              data-variant-available="{{ var.available }}"
              {% if var.id == v0.id %}checked{% endif %}
              {% unless var.available %}disabled{% endunless %}>
            <label
              class="ona-pc__pill{% if var.id == v0.id %} ona-pc__pill--active{% endif %}{% unless var.available %} ona-pc__pill--sold-out{% endunless %}"
              data-card-pill
              for="{{ radio_id }}">{{- var.title -}}</label>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    <form id="{{ card_form_id }}" action="{{ routes.cart_add_url }}" method="post" data-card-form>
      {%- unless product.variants.size > 1 and product.options.size == 1 -%}
        <input type="hidden" name="id" value="{{ v0.id }}">
      {%- endunless -%}
      <input type="hidden" name="quantity" value="1">
      <button type="submit" class="ona-pc__atc"{% unless v0.available %} disabled{% endunless %} data-card-atc>
        {%- if v0.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
      </button>
    </form>
  </div>
</div>
{%- endif -%}
