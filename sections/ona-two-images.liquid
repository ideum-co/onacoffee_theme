<section class="two-columns-image">
  <div class="container">
    <div class="content wowo fadeInUp">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="list">
            <a href="{{ block.settings.url }}" class="list-box">
              <div class="img-bg" style="background-image: url('{{ block.settings.image | img_url: '1270x' }}')"></div>
              <h2>{{ block.settings.title }}</h2>
            </a>
          </div>
        {% endfor %}
      {% endif %} 
    </div>
  </div>
</section>
{% stylesheet %}
  /* Vertical rhythm.
     ona_theme2026 runs a consistent 80/80 padding rhythm across the home page
     (120 for feature blocks, 100/80 for Learn with ONA, 64 for press quotes).
     This theme instead carried a large margin-bottom in assets/main.css, which
     produced 0px gaps between sections and no rhythm at all.

     Overriding rather than editing main.css: that file is minified and shared.
     `section.two-columns-image` is specificity (0,1,1), which beats the (0,1,0) rules in
     main.css at every breakpoint, including the responsive variants. */
  section.two-columns-image {
    margin-bottom: 0;
    padding-block: 80px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": {
    "en": "Two Images"
  },
  "max_blocks": 2,
  "blocks": [
    {
      "type": "block",
      "name": {
        "en": "Block"
      },
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": {
            "en": "Image"
          }
        },
        {
          "type": "text",
          "id": "title",
          "label": {
            "en": "Title"
          }
        },
        {
          "type": "url",
          "id": "url",
          "label": {
            "en": "Button url"
          }
        }
      ]
    }
  ],
  "presets": [
    {
      "name": {
        "en": "Two Images"
      },
      "category": {
        "en": "Image"
      }
    }
  ]
}
{% endschema %}