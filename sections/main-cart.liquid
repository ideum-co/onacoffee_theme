

{% capture cart_page_more_blocks_content %}
  <div class="cart-page__more-blocks">
    {%- content_for 'blocks' -%}
  </div>
{% endcapture %}

{% capture cart_items_children %}
  <template id="empty-cart-template">
    <div class="section-background color-{{ section.settings.color_scheme }}"></div>
    <div
      class="section color-{{ section.settings.color_scheme }} section--{{ section.settings.section_width }}"
    >
      <div
        class="cart-page spacing-style{% if cart.empty? %} cart-page--empty{% endif %}"
        style="{% render 'spacing-style', settings: section.settings %}"
      >
        <div class="cart-page__title">
          {%- content_for 'block', id: 'cart-page-title', type: '_cart-title', force_empty: true %}
        </div>
        <div class="cart-page__items">
          {%- content_for 'block', id: 'cart-page-items', type: '_cart-products', force_empty: true %}
        </div>
        {{ cart_page_more_blocks_content }}
      </div>
    </div>
  </template>

  {% # theme-check-disable UniqueStaticBlockId %}
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <div
    class="section color-{{ section.settings.color_scheme }} section--{{ section.settings.section_width }}"
  >
    <div
      class="cart-page spacing-style{% if cart.empty? %} cart-page--empty{% endif %}"
      style="{% render 'spacing-style', settings: section.settings %}"
    >
      <div class="cart-page__title">
        {%- content_for 'block', id: 'cart-page-title', type: '_cart-title' %}
      </div>

      {%- comment -%}
        Qikify order-goal / free-shipping progress bar (third-party app embed,
        not theme code -- the app's own JS renders into this mount point).
        Ported verbatim from ona-cart-template.liquid; only rendered when the
        cart has items, matching that template's effective behavior (it
        rendered unconditionally but the whole wrapper was display:none on an
        empty cart).
      {%- endcomment -%}
      {%- unless cart.empty? -%}
        {%- render 'qikify-reward-bar' -%}
      {%- endunless -%}

      <div class="cart-page__items">
        {%- content_for 'block', id: 'cart-page-items', type: '_cart-products' %}
      </div>

      {%- unless cart.empty? -%}
        <div class="cart-page__summary">
          {%- content_for 'block', id: 'cart-page-summary', type: '_cart-summary' -%}
        </div>
      {%- endunless -%}

      {%- comment -%}
        Mixed-cart preorder detection, ported from ona-cart-template.liquid.
        Fix 2026-08-10 (already applied here, not re-introducing the pre-fix bug):
        a line's underscore-prefixed properties (e.g. Qikify's free-gift markers
        _qbk-trigger-id/_qbk-offer-id/_qbk-offer-type) are app-internal and must
        NOT count as "preorder" -- only a genuine, customer-visible property
        counts. Scoped to disable/warn on THIS page's own checkout button only
        (queried by container class, not id, since the shared cart-drawer
        renders the same #checkout id when the drawer's DOM is present but
        closed) -- the live cart drawer's own checkout flow is intentionally
        untouched by this port, matching the bespoke page's original scope.
      {%- endcomment -%}
      {%- unless cart.empty? -%}
        {%- liquid
          assign normal_count = 0
          assign preorder_count = 0
          for item in cart.items
            assign has_pp = false
            for p in item.properties
              assign first_char = p.first | slice: 0
              if p.last != blank and first_char != '_'
                assign has_pp = true
              endif
            endfor
            if has_pp
              assign preorder_count = preorder_count | plus: 1
            else
              assign normal_count = normal_count | plus: 1
            endif
          endfor
        -%}
        {%- if normal_count > 0 and preorder_count > 0 -%}
          {%- comment -%} Reuses the existing global .preorder-tips-popup CSS
            (assets/main.css) verbatim -- same class name as the bespoke page
            used, so no new styling needed here. {%- endcomment -%}
          <div class="preorder-tips-popup show-popup">
            <div class="popup-box">
              <button class="close-btn" type="button" onclick="this.closest('.preorder-tips-popup').classList.remove('show-popup')">&times;</button>
              <div class="popup-text">
                <h2>{{ settings.ppc_title | default: 'Pre-order items detected' }}</h2>
                {{ settings.ppc_content | default: '<p>Your cart contains both regular and pre-order items. Please check out separately.</p>' }}
              </div>
            </div>
          </div>
          <script>
            (function () {
              var btn = document.querySelector('.cart-page .cart__checkout-button');
              if (btn) { btn.setAttribute('disabled', 'disabled'); }
            })();
          </script>
        {%- endif -%}
      {%- endunless -%}

      {%- comment -%}
        Gift-item remove-button suppression, ported from ona-cart-template.liquid.
        Verified 2026-09-05: variant 40126200709311 (ONA Anniversary Tote Bag,
        product handle ona-tote, DRAFT status -- only ever added via Qikify's
        free-gift-with-purchase app, never directly by a shopper) is still the
        correct, active gift-item id. Native cart-products.liquid already
        checks `item.instructions.can_remove` (a real Shopify cart-line field,
        typically set by cart transform/validation functions) -- if Qikify's
        app already sets that, this CSS is redundant and harmless; if it
        doesn't (Qikify is a JS-only app, not a Shopify Function, so this is
        the more likely case), this CSS is what actually hides the button.
        Scoped to .cart-page so the live cart drawer's own rendering of this
        same line item (if the drawer's remove button is otherwise correct or
        incorrect) is intentionally untouched by this port.
      {%- endcomment -%}
      <style>
        .cart-page [data-key^="40126200709311:"] .cart-items__remove { display: none; }
      </style>

      {%- comment -%}
        US shipping/tariff notice, ported from ona-cart-template.liquid's
        cart-note block. Native cart notes (settings.show_cart_note) are a
        SEPARATE, already-shared feature used by the live cart drawer --
        deliberately not touched here so this port doesn't change live drawer
        behavior. This notice is self-contained to this section instead.
      {%- endcomment -%}
      {%- if localization.country.iso_code == 'US' and cart.empty? == false -%}
        <div class="cart-page__us-shipping-notice rte" style="margin:16px 0;padding:12px;border:1px solid var(--color-border);">
          <strong>Shipping to the USA:</strong>
          US government tariffs or import restrictions may limit delivery or add extra charges at customs. These fees aren't included at checkout.
        </div>
        {%- comment -%} form="cart-form" associates these with cart-products.liquid's
          shared form without editing that shared snippet. {%- endcomment -%}
        <input type="hidden" name="attributes[Destination Country]" value="US" form="cart-form">
        <input type="hidden" name="attributes[US Shipping Notice]" value="Customer saw customs/duties message" form="cart-form">
      {%- endif -%}

      {{ cart_page_more_blocks_content }}
    </div>
  </div>
  {% # theme-check-enable UniqueStaticBlockId %}
{% endcapture %}
{% render 'cart-items-component', children: cart_items_children, section_id: section.id %}

{% stylesheet %}
  .cart-page {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 var(--padding-5xl);
  }

  .cart-page--empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .cart-page--empty .cart-page__title,
  .cart-page--empty .cart-page__more-blocks {
    margin-top: var(--margin-6xl);
  }

  .cart-page__more-blocks {
    width: 100%;
  }

  .cart-page--empty .cart-title {
    text-align: center;
  }

  .cart-page__main {
    grid-column: 1;
  }

  .cart-page__summary {
    padding-top: var(--padding-xl);
  }

  .cart-page__title + .cart-page__items {
    margin-block-start: var(--margin-lg);
  }

  @media screen and (min-width: 750px) {
    .cart-page {
      grid-template-columns: 1fr min(50vw, var(--sidebar-width));
      grid-template-rows: min-content min-content 1fr;
    }

    .cart-page__summary {
      display: grid;
      height: 100%;
      grid-column: 2;
      grid-row: 1 / -1;
      align-self: stretch;
      grid-template-rows: subgrid;
      padding-top: 0;

      /* needed to support blurred effect from hero section */
      position: relative;
    }

    .section--page-width .cart-page:has(.cart-summary--extend) {
      grid-column: 2 / 4;
      grid-template-columns: 1fr minmax(
          var(--sidebar-width),
          calc((100vw - var(--page-width)) / 2 + var(--sidebar-width))
        );
    }
  }

  @media screen and (min-width: 1400px) {
    .cart-page {
      grid-template-columns: 1fr var(--sidebar-width);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.cart",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "video"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
