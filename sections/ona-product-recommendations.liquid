{%- liquid
  assign show = section.settings.show_product_recommendations
  assign heading = section.settings.heading
  assign limit = 4
  # ona-product-card.liquid renders nothing at all for this handle. Requesting
  # more than `limit` candidates (rather than exactly `limit`) means a tote
  # landing in the recommended set still leaves room to backfill with a real
  # product instead of silently shrinking the row to 3.
  assign fetch_limit = 8

  # Mirror Horizon's fallback: use recommendations when available, else pull from
  # the catalog so the block never renders empty on first paint.
  if recommendations.performed and recommendations.products_count > 0
    assign products = recommendations.products
  else
    assign products = null
  endif
-%}

{%- if show -%}
<product-recommendations
  id="product-recommendations-{{ section.id }}"
  data-url="{{ routes.product_recommendations_url }}?limit={{ fetch_limit }}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-intent="related"
  data-recommendations-performed="false"
>
  {%- if products != blank -%}
    <section class="recommendations-list also-shop">
      <div class="container">
        {%- if heading != blank -%}
          <div class="top">
            <h2>{{ heading | escape }}</h2>
            <a href="/collections/all">SEE ALL</a>
          </div>
        {%- endif -%}
        <div class="shop-list">
          {%- liquid
            assign rendered_count = 0
            for p in products limit: fetch_limit
              if rendered_count >= limit
                break
              endif
              if p.handle == 'ona-tote'
                continue
              endif
              # Recommendations render below the fold, populated async -- never
              # pass an index here, so ona-product-card.liquid's image loading
              # always falls through to its lazy branch (an index <= 4 would
              # mark these eager/high-priority, competing with real above-the-
              # fold resources for a section the shopper hasn't scrolled to yet).
              render 'ona-product-card', product: p
              assign rendered_count = rendered_count | plus: 1
            endfor
          -%}
        </div>
      </div>
    </section>
  {%- endif -%}
</product-recommendations>
{%- comment -%}
  Variant picker + AJAX Add to cart now handled by the shared global
  assets/ona-product-card.js, which delegates from `document` rather than
  binding to specific card elements — so it doesn't matter whether these
  cards were server-rendered or spliced in later via the innerHTML fetch
  below, unlike the old per-render inline <script> this section used to emit
  (which only ever ran once, before the fetched cards existed, since a
  <script> assigned via innerHTML never executes).
{%- endcomment -%}
<script>
  (function(){
    var el = document.getElementById('product-recommendations-{{ section.id }}');
    if (!el || el.querySelector('section.recommendations-list')) return;
    var url = el.getAttribute('data-url') +
              '&product_id=' + el.getAttribute('data-product-id') +
              '&section_id=' + el.getAttribute('data-section-id') +
              '&intent=' + el.getAttribute('data-intent');
    fetch(url).then(function(r){ return r.text(); }).then(function(html){
      var doc = new DOMParser().parseFromString(html, 'text/html');
      var inner = doc.querySelector('#product-recommendations-{{ section.id }}');
      if (inner) {
        el.innerHTML = inner.innerHTML;
        // Cards just landed via innerHTML, so ona-product-card-atc.liquid's
        // own init (bound on DOMContentLoaded, before these existed) never
        // saw them. Its script also listens for 'shopify:section:load' --
        // reuse that hook to pick up the freshly-injected cards without
        // duplicating its init logic here.
        document.dispatchEvent(new Event('shopify:section:load'));
      }
    }).catch(function(e){ console.warn('[ONA recs]', e); });
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "ONA recommendations",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_product_recommendations",
      "label": "Show recommendations",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    }
  ]
}
{% endschema %}
