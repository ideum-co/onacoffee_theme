<section class="page-title">
    <div class="container">
        <h1 class="collection-title">
          {% if collection.metafields.custom.alternative_collection_title %}
            {{ collection.metafields.custom.alternative_collection_title }}
          {% else %}
            {{ collection.title }}
          {% endif %}
        </h1>
    </div>
    {% assign collectionDescription = collection.description | split:"<!-- split -->"%}

    <div class="topdescription container"> {{ collectionDescription | first }}</div>
</section>
<section class="shop-content" data-section-type="collection-template">
  <div class="container">
    {%- assign limit = 24 -%}
    {% paginate collection.products by limit %}
    <div class="shop-top {% if section.settings.showbanner == 'yes' %} has-banner{% endif %}">

      {% render 'ona-filter-drawer-skin' %}
      {% content_for 'block', type: 'filters', id: 'filters', results: collection, results_size: collection.products_count %}
      {% if section.settings.showbanner == 'yes' %}
        
      <div class="archive-page-banner">
        <div class="bg-box">
          {% if section.settings.bgtype == 'image' %}
          <div class="image-box" style="background-image:url('{{ section.settings.image | img_url: '1270x'  }}');"></div>
          {% else %}
          <div class="video-box">
            <video class="video-pc" muted="muted" autoplay="autoplay" loop="loop">
              <source src="{{section.settings.video.sources[1].url}}" type="video/mp4" >
            </video>
          </div>
          {% endif %}
          <div class="text-box">
            <h2>{{ section.settings.banner_text }}</h2>
          </div>
        </div>
      </div>

      {% endif %}
      {% if limit < collection.products_count %}
        {% if paginate.current_page == paginate.pages %}
          <p class="results">SHOWING {{ collection.products_count | modulo: limit }} OF {{ collection.products_count }} RESULTS</p>
        {% else %}
          <p class="results">SHOWING {{limit}} OF {{ collection.products_count }} RESULTS</p>
        {% endif %}
      {% else %}
        <p class="results">SHOWING ALL {{ collection.products_count }} RESULTS</p>
      {% endif %}
      
      <div class="sort-by">

        <div class="filters-toolbar__item-child">
          {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
          <label class="filters-toolbar__label select-label" for="SortBy">{{ 'collections.sorting.title' | t }}</label>
          <div class="filters-toolbar__input-wrapper select-group">
            <select name="sort_by" id="SortBy"
                    class="filters-toolbar__input"
                    aria-describedby="a11y-refresh-page-message a11y-selection-message"
                    data-default-sortby="{{ collection.default_sort_by }}"
                    data-select-input
                    >
              {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}" {% if option.value == sort_by %}selected="selected"{% endif %}>{{ option.name }}</option>
              {%- endfor -%}
            </select>
            {% include 'icon-chevron-down' %}
          </div>
        </div>

      </div>
      <script>
        (function(){
          var sel = document.getElementById('SortBy');
          if (!sel) return;
          sel.addEventListener('change', function(){
            var url = new URL(window.location.href);
            url.searchParams.set('sort_by', sel.value);
            url.searchParams.delete('page');
            window.location.href = url.toString();
          });
        })();
      </script>
    </div>
    {%- comment -%}
      Category tile row ("Discover by category"). Replaces the old plain-text
      .tab-filter list + section.blocks-driven featured_collection blocks --
      section.blocks can't coexist with the native `content_for 'block', type:
      'filters'` hook used above, so this reads from fixed collection-picker
      settings instead (category_tile_1..10). Same 10 curated collections
      carried over 1:1 from the old blocks config, just a different mechanism.
      Text-only links (no images), matching production's original tab style.
    {%- endcomment -%}
    {%- assign current_title = collection.title -%}
    <div class="category-tiles">
      <div class="category-tiles__track">
        <a
          href="{{ collections.all.url }}"
          class="category-tile{% if current_title == collections.all.title %} category-tile--active{% endif %}"
        >
          <span class="category-tile__label">All Coffee</span>
        </a>
        {%- for i in (1..10) -%}
          {%- assign setting_key = 'category_tile_' | append: i -%}
          {%- assign tile_collection = section.settings[setting_key] -%}
          {%- if tile_collection != blank -%}
            <a
              href="{{ tile_collection.url }}"
              class="category-tile{% if tile_collection.title == current_title %} category-tile--active{% endif %}"
            >
              <span class="category-tile__label">{{ tile_collection.title }}</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
    <div class="shop-list test" data-count="{{ collection.products_count }}">
      {% for product in collection.products %}
        {% render 'ona-product-card', product: product, index: forloop.index %}
      {% endfor %}
    </div>

      <div class="bottomdescription container">{{ collectionDescription | last}}</div>


    {%- if paginate.pages > 1 -%}
    {% include 'pagination', paginate: paginate %}
    {%- endif -%}

      
    {% endpaginate %}
    
    

  
    
  </div>
</section>


{% comment %} Custom .filters-wrapper panel removed 2026-08 -- replaced by the native
   filters block hooked in above (content_for 'block', type: 'filters'). See
   PR for migration details. {% endcomment %}

